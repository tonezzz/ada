############################
# Core Gemini configuration
############################

# Google Gemini API Key
# Get yours here: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Gemini Live model (voice)
# Pick a model your key/region has access to.
ADA_GEMINI_MODEL=models/gemini-2.5-flash-native-audio-latest

# (Optional) Modalities for Live session response (AUDIO, TEXT, etc)
ADA_RESPONSE_MODALITIES=AUDIO

# Gemini text model (used by some backend helpers)
GEMINI_TEXT_MODEL=gemini-2.5-flash

# Gemini image model (used by server image generation)
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

############################
# Assistant audio settings
############################

# Assistant output audio sample rate expected by PyAudio playback (non-browser audio)
ADA_RECEIVE_SAMPLE_RATE=24000

# If you need to disable sending audio/images to Gemini for debugging
# ADA_DISABLE_AUDIO_SEND=0
# ADA_DISABLE_IMAGE_SEND=0

############################
# VAD / mic tuning (PyAudio)
############################

ADA_AUDIO_VAD_THRESHOLD=800
ADA_AUDIO_SILENCE_S=0.5
ADA_AUDIO_VAD_ATTACK_FRAMES=3
ADA_AUDIO_MIN_UTTERANCE_FRAMES=4
ADA_AUDIO_SEND_SILENCE=0

############################
# VAD / mic tuning (Browser audio)
############################

BROWSER_AUDIO_VAD_THRESHOLD=1200
BROWSER_AUDIO_SILENCE_S=0.7
BROWSER_AUDIO_VAD_ATTACK_FRAMES=3
BROWSER_AUDIO_MIN_UTTERANCE_FRAMES=2
BROWSER_AUDIO_PREROLL_CHUNKS=4
BROWSER_AUDIO_SEND_SILENCE=0

############################
# Tool calling / MCP
############################

# 1MCP HTTP endpoint (required for MCP tools)
ONE_MCP_URL=

# Tool init and call timeouts
ADA_TOOL_INIT_TIMEOUT_S=2.0
ADA_TOOL_CALL_TIMEOUT_S=10.0

# Native tool responses (can cause 1008 on some Live endpoints; keep off unless you know it works)
ADA_USE_NATIVE_TOOL_RESPONSES=0

# Allow safe plain-text tool results fallback
ADA_TOOL_RESPONSE_TEXT_FALLBACK=1

# Async tool calls (faster perceived response)
ADA_ASYNC_TOOL_CALLS=0

############################
# Feature flags
############################

ADA_ENABLE_PROJECT_TOOLS=0
ADA_ENABLE_CAD_TOOLS=0
ADA_ENABLE_FS_TOOLS=0

############################
# Optional image backends (server.py)
############################

# IMAGE_BACKEND=gemini | mcp_imagen
IMAGE_BACKEND=gemini

MCP_IMAGEN_BASE_URL=http://mcp-imagen-light:8020
MCP_IMAGEN_TIMEOUT_S=180

# Optional external MCP proxy endpoints
MCP_GLAMA_BASE_URL=http://127.0.0.1:7441
